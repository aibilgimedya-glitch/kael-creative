<script>
  // ── HERO SCROLL ──
  const wrapper = document.getElementById('hero-scroll-wrapper');
  const img = document.getElementById('hero-img');
  const scrollBar = document.getElementById('scroll-bar');
  const scrollLabel = document.getElementById('scroll-label');
  const scenes = [
    'scene1_clouds.png',
    'scene2_hand.png',
    'scene3_activation.png'
  ];
  let currentScene = 0;

  // preload
  scenes.forEach(src => { const i = new Image(); i.src = src; });

  // fade in first scene
  window.addEventListener('load', () => {
    img.src = scenes[0];
    img.style.opacity = '1';
  });

  window.addEventListener('scroll', () => {
    const rect = wrapper.getBoundingClientRect();
    const total = wrapper.offsetHeight - window.innerHeight;
    const scrolled = -rect.top;
    const progress = Math.max(0, Math.min(1, scrolled / total));

    // scroll bar
    scrollBar.style.width = (progress * 100) + '%';

    // hide scroll label after start
    scrollLabel.style.opacity = progress > 0.05 ? '0' : '';

    // scene switch (0–33%, 33–66%, 66–100%)
    let targetScene;
    if (progress < 0.33) targetScene = 0;
    else if (progress < 0.66) targetScene = 1;
    else targetScene = 2;

    if (targetScene !== currentScene) {
      currentScene = targetScene;
      img.style.opacity = '0';
      setTimeout(() => {
        img.src = scenes[currentScene];
        img.style.opacity = '1';
      }, 300);
    }
  }, { passive: true });

  // ── REVEAL ON SCROLL ──
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  revealEls.forEach(el => io.observe(el));

  // ── FORM ──
  document.getElementById('contact-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('.form-submit');
    btn.textContent = 'Gönderiliyor...';
    btn.disabled = true;
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(e.target)))
      });
      if (res.ok) {
        document.getElementById('form-success').style.display = 'block';
        e.target.reset();
      }
    } catch {}
    btn.textContent = 'Gönder →';
    btn.disabled = false;
  });
</script>

